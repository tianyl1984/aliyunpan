# 复制为 .env 后修改，docker compose 会自动读取。
# .env 里是明文口令，不要提交进 git。
#
# 说明：aliyunpan webui 命令本身只认命令行参数，这里的环境变量由容器的
# entrypoint.sh 翻译成对应的参数。所以这些变量只在 docker 部署下有效，
# 直接跑二进制请用 `aliyunpan webui --help` 里的同名参数。

# ============ 登录方式 ============
# 两种方式并存，至少要有一种，否则容器拒绝启动：
#   1. token / 口令登录：设 ALIYUNPAN_WEBUI_PASSWORD
#   2. 第三方登录：设 ALIYUNPAN_WEBUI_AUTH_URL（见下面的「第三方登录」段）
# 两个都设就是两种都能用，登录页会同时出现输入框和第三方登录按钮。

# Web 界面访问口令。建议用随机串，例如：
#   openssl rand -base64 24
# 只用第三方登录时可以留空。注意留空后程序仍会自动生成一个随机 token 并打印到
# 容器日志（docker compose logs），那个 token 同样能登录。
ALIYUNPAN_WEBUI_PASSWORD=change-me-please

# ---- 以下都是可选项，不填就用 docker-compose.yml 里的默认值 ----

# 宿主端口。改成和容器端口(8080)不一致时，记得在 ALIYUNPAN_WEBUI_TRUSTED_ORIGINS
# 或 ALIYUNPAN_WEBUI_EXTERNAL_URL 里补上浏览器实际访问的地址，否则登录会 403。
WEBUI_PORT=8070

# 配置目录（宿主侧）。存登录凭据、webui.json、下载断点、上传暂存。
# 相对路径的基准是 docker-compose.yml 所在目录；挂到别处请写绝对路径。
ALIYUNPAN_CONFIG_DIR=./config

# 下载/浏览目录（宿主侧），对应容器内的 /data。
ALIYUNPAN_DATA_DIR=./downloads

# 可信来源：浏览器地址栏里实际用的地址，多个用英文逗号分隔，必须带 http:// 或 https://。
# 端口映射不一致、或走反向代理时必须声明，否则写操作（含登录）返回 403 Origin 不匹配。
# 例: ALIYUNPAN_WEBUI_TRUSTED_ORIGINS=https://pan.example.com,http://192.168.1.10:9000
ALIYUNPAN_WEBUI_TRUSTED_ORIGINS=

# 本服务的对外访问地址，形如 https://pan.example.com（不要带路径）。
# 用途有两个：
#   1. 第三方登录据此拼回调地址。走反向代理或端口映射时基本是必填 ——
#      不填只能从请求 Host 头推导，推导不出来登录会失败并提示。
#   2. 会自动并入可信来源，所以填了这里就不用在 TRUSTED_ORIGINS 里再写一遍。
ALIYUNPAN_WEBUI_EXTERNAL_URL=

# ============ 第三方登录（可选） ============
# 把身份校验委托给外部认证服务 cf-worker-auth（Cloudflare Worker + GitHub OAuth）。
# 留空则不启用，登录页只有 token/口令输入框。
#
# 启用前需要在认证服务侧准备好：
#   1. KV 的 legal_domain 里加上 ALIYUNPAN_WEBUI_EXTERNAL_URL 的域名，
#      否则跳转过去会直接报 callback error。
#   2. KV 的 legal_user 里加上允许登录的 GitHub 用户名。
# 回调地址为 <ALIYUNPAN_WEBUI_EXTERNAL_URL>/api/auth/oauth/callback/<state>，
# 容器启动日志里会把它打出来，可以直接对着核对。

# 认证服务地址，形如 https://auth.example.com
ALIYUNPAN_WEBUI_AUTH_URL=

# 允许通过第三方登录的用户名（GitHub login），多个用英文逗号分隔。
# 留空表示完全信任认证服务自身的 legal_user 白名单；填了就是在本端再拦一层，
# 适合一个认证服务对多个业务、但本服务只想放行其中几个人的场景。
# 例: ALIYUNPAN_WEBUI_AUTH_USERS=octocat,torvalds
ALIYUNPAN_WEBUI_AUTH_USERS=
